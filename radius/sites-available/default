# FreeRADIUS virtual server for MikroTik Billing
# All users and groups come from the SQL tables written by the API.

server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    listen {
        type = acct
        ipaddr = *
        port = 0
    }

    # Change-of-Authorization / Packet of Disconnect, used by FUP and
    # auto-suspend to terminate active sessions after a policy change.
    listen {
        type = coa
        ipaddr = *
        port = 3799
    }

    authorize {
        preprocess
        sql
        expiration
        logintime
        pap
        chap
        mschap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    preacct {
        preprocess
    }

    accounting {
        sql
    }

    session {
        sql
    }

    post-auth {
        sql
    }

    disconnect {
        ok = return
    }
}
