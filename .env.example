# Artifacts workspace Docker configuration.
# Replace every placeholder before production deployment.
DB_NAME=mikrotik_config_builder
DB_USER=postgres
DB_PASSWORD=replace_with_a_secure_database_password
DATABASE_URL=
JWT_SECRET=replace_with_a_long_random_jwt_secret
ENCRYPTION_KEY=replace_with_a_32_byte_encryption_key
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_admin_password
APP_URL=https://billing.example.com
CORS_ORIGIN=https://billing.example.com
VPN_SERVER_ADDRESS=
VPN_SERVER_PORT=443
RADIUS_DB_NAME=mikrotik_config_builder
RADIUS_SECRET=replace_with_a_long_radius_shared_secret
RADIUS_SERVER=radius
ENABLE_ROUTER_CONNECTIVITY=true
ENABLE_MONITORING_API=true
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=MyISP
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox
# Required in production. Append ?key=<this-value> to the Daraja C2B
# Validation and Confirmation callback URLs registered with Safaricom.
MPESA_C2B_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
METRICS_TOKEN=
MONTHLY_SALES_TARGET=100000
TR069_ACS_URL=http://192.168.100.8:17547
TR069_NBI_URL=http://localhost:17557
TR069_PORT=7547
GENIEACS_UI_JWT_SECRET=change-me
VITE_API_URL=/api
# Public HTTPS base URL of this app. The hosted hotspot page is served at
# <VITE_PUBLIC_APP_URL>/hotspot and must be reachable by hotspot guests.
VITE_PUBLIC_APP_URL=https://billing.example.com
# Local testing only: allow a private/http portal URL. Never enable in production.
ALLOW_INSECURE_PORTAL_URL=false
# Migration aids. Leave disabled in production.
ALLOW_PHONE_SUFFIX_PIN=false
ALLOW_DEV_RESET_CODE=false
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_PAYBILL=
COMPANY_NAME=
SUPPORT_PHONE=
SENTRY_DSN=
SENTRY_RELEASE=
SENDGRID_API_KEY=
MAILGUN_USER=
MAILGUN_PASSWORD=
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_USER=
AWS_SES_PASSWORD=
# DNS Ad-Blocker. Optional: without a public HTTPS base URL the platform
# deploys static DNS entries directly over the RouterOS API (works on any version).
DNS_ADBLOCK_MODE=auto
DNS_ADBLOCK_STATIC_MAX_DOMAINS=5000
DNS_ADBLOCK_MAX_DOMAINS=250000
DNS_ADBLOCK_ALLOWED_HOSTS=
DNS_ADBLOCK_PUBLIC_BASE_URL=
DNS_ADBLOCK_FEED_SECRET=
# Public IP/DNS of the Linux VPS running the WireGuard tunnel server.
WG_SERVER_ENDPOINT=
# Local lab only: allow an http:// enrollment URL in the remote-link script.
ALLOW_INSECURE_ROUTER_ENROLLMENT=false
WG_TUNNEL_SUBNET=10.200.0
WG_TUNNEL_PORT=51820
WG_INTERFACE=wg-billing
WG_PERSISTENT_KEEPALIVE=25
